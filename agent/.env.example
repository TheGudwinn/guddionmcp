# Semicolon-separated list of directories to scan for projects.
CATALOG_DIRS=/path/to/your/projects;/another/path

# Where the local catalog SQLite file lives.
CATALOG_DB_PATH=./catalog.db

# Only needed if you're using delegate_task against a self-hosted backend
# (see the backend/ package in this repo).
GUDDION_BACKEND_URL=https://your-backend.example.com
GUDDION_BACKEND_TOKEN=your-per-user-bearer-token
